APP_ENV=local
DATABASE_URL=sqlite:///./image_hosting.db

AWS_REGION=us-east-2
S3_BUCKET=your-local-bucket-name
CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

PRESIGNED_URL_EXPIRES_SECONDS=300
MAX_FILE_SIZE_MB=10
ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif

# true: 不需要真實 AWS，可用本地開發與測試
# false: 使用真實 AWS S3
USE_MOCK_AWS=true

# Magic Number validation
VALIDATE_MAGIC_BYTES=true
MAGIC_BYTES_LIMIT=2048

LOG_LEVEL=INFO